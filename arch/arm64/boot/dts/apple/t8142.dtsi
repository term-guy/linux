// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Apple T8142 "M5" SoC
 *
 * Minimal bring-up tree derived from the J704 ADT (macOS 27.0) and t8132.dtsi.
 * Power domains come from t8142-pmgr.dtsi (generated from the ADT).
 */

#include <dt-bindings/interrupt-controller/apple-aic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/apple.h>

/ {
	compatible = "apple,t8142", "apple,arm-platform";

	#address-cells = <2>;
	#size-cells = <2>;

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu_e0>;
				};
				core1 {
					cpu = <&cpu_e1>;
				};
				core2 {
					cpu = <&cpu_e2>;
				};
				core3 {
					cpu = <&cpu_e3>;
				};
				core4 {
					cpu = <&cpu_e4>;
				};
				core5 {
					cpu = <&cpu_e5>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu_p0>;
				};
				core1 {
					cpu = <&cpu_p1>;
				};
				core2 {
					cpu = <&cpu_p2>;
				};
				core3 {
					cpu = <&cpu_p3>;
				};
			};
		};

		cpu_e0: cpu@0 {
			compatible = "apple,hidra-e";
			device_type = "cpu";
			reg = <0x0 0x0>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>; /* to be filled by loader */
			next-level-cache = <&l2_cache_0>;
		};

		cpu_e1: cpu@1 {
			compatible = "apple,hidra-e";
			device_type = "cpu";
			reg = <0x0 0x1>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu_e2: cpu@2 {
			compatible = "apple,hidra-e";
			device_type = "cpu";
			reg = <0x0 0x2>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu_e3: cpu@3 {
			compatible = "apple,hidra-e";
			device_type = "cpu";
			reg = <0x0 0x3>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu_e4: cpu@4 {
			compatible = "apple,hidra-e";
			device_type = "cpu";
			reg = <0x0 0x4>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu_e5: cpu@5 {
			compatible = "apple,hidra-e";
			device_type = "cpu";
			reg = <0x0 0x5>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_0>;
		};

		cpu_p0: cpu@10100 {
			compatible = "apple,hidra-p";
			device_type = "cpu";
			reg = <0x0 0x10100>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_1>;
		};

		cpu_p1: cpu@10101 {
			compatible = "apple,hidra-p";
			device_type = "cpu";
			reg = <0x0 0x10101>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_1>;
		};

		cpu_p2: cpu@10102 {
			compatible = "apple,hidra-p";
			device_type = "cpu";
			reg = <0x0 0x10102>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_1>;
		};

		cpu_p3: cpu@10103 {
			compatible = "apple,hidra-p";
			device_type = "cpu";
			reg = <0x0 0x10103>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_1>;
		};

		l2_cache_0: l2-cache-0 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			cache-size = <0x600000>;
		};

		l2_cache_1: l2-cache-1 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
			cache-size = <0x1000000>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&aic>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <AIC_FIQ AIC_TMR_GUEST_PHYS IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_FIQ AIC_TMR_GUEST_VIRT IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_FIQ AIC_TMR_HV_PHYS IRQ_TYPE_LEVEL_HIGH>,
		             <AIC_FIQ AIC_TMR_HV_VIRT IRQ_TYPE_LEVEL_HIGH>;
	};

	clkref: clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "clkref";
	};

	soc: soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;

		ranges;
		nonposted-mmio;

		pmgr: power-management@380700000 {
			compatible = "apple,t8142-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x3 0x80700000 0 0x14000>;
		};

		aic: interrupt-controller@381000000 {
			compatible = "apple,t8142-aic3", "apple,t8122-aic3";
			#interrupt-cells = <3>;
			interrupt-controller;
			reg = <0x00000003 0x81000000 0x00000000 0x1cc000>,
			      <0x00000003 0x81040000 0x00000000 0x4000>;
			reg-names = "core", "event";
			power-domains = <&ps_aic>;

			affinities {
				e-core-pmu-affinity {
					apple,fiq-index = <AIC_CPU_PMU_E>;
					cpus = <&cpu_e0 &cpu_e1 &cpu_e2 &cpu_e3 &cpu_e4 &cpu_e5>;
				};

				p-core-pmu-affinity {
					apple,fiq-index = <AIC_CPU_PMU_P>;
					cpus = <&cpu_p0 &cpu_p1 &cpu_p2 &cpu_p3>;
				};
			};
		};

		pmgr_mini: power-management@388280000 {
			compatible = "apple,t8142-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x3 0x88280000 0 0x4000>;
		};

		pmgr_gfx: power-management@580e80000 {
			compatible = "apple,t8142-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			#address-cells = <1>;
			#size-cells = <1>;
			reg = <0x5 0x80e80000 0 0x4000>;
		};

		wdt: watchdog@3882b0000 {
			compatible = "apple,t8142-wdt", "apple,t8103-wdt";
			reg = <0x3 0x882b0000 0x0 0x4000>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 361 IRQ_TYPE_LEVEL_HIGH>;
		};

		pinctrl_nub: pinctrl@3881f0000 {
			compatible = "apple,t8142-pinctrl", "apple,t8103-pinctrl";
			reg = <0x3 0x881f0000 0x0 0x4000>;
			power-domains = <&ps_nub_gpio>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_nub 0 0 32>;
			apple,npins = <32>;

			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 574 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 575 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 576 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 577 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 578 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 579 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 580 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled"; /* npins unverified on T8142 */
		};

		pinctrl_smc: pinctrl@38c820000 {
			compatible = "apple,t8142-pinctrl", "apple,t8103-pinctrl";
			reg = <0x3 0x8c820000 0x0 0x4000>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_smc 0 0 18>;
			apple,npins = <18>;

			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 624 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 625 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 626 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 627 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 628 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 629 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 630 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled"; /* npins unverified on T8142 */
		};

		pinctrl_aop: pinctrl@390824000 {
			compatible = "apple,t8142-pinctrl", "apple,t8103-pinctrl";
			reg = <0x3 0x90824000 0x0 0x4000>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_aop 0 0 57>;
			apple,npins = <57>;

			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 480 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 481 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 482 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 483 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 484 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 485 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 486 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled"; /* npins unverified on T8142 */
		};

		pinctrl_ap: pinctrl@39a000000 {
			compatible = "apple,t8142-pinctrl", "apple,t8103-pinctrl";
			reg = <0x3 0x9a000000 0x0 0x100000>;
			power-domains = <&ps_gpio>;

			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl_ap 0 0 224>;
			apple,npins = <224>;

			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 347 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 348 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 349 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 350 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 351 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 352 IRQ_TYPE_LEVEL_HIGH>,
			             <AIC_IRQ 353 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled"; /* npins unverified on T8142 */
		};

		i2c0: i2c@3a5010000 {
			compatible = "apple,t8142-i2c", "apple,t8103-i2c";
			reg = <0x3 0xa5010000 0x0 0x4000>;
			power-domains = <&ps_i2c0>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1247 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c1: i2c@3a5014000 {
			compatible = "apple,t8142-i2c", "apple,t8103-i2c";
			reg = <0x3 0xa5014000 0x0 0x4000>;
			power-domains = <&ps_i2c1>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1248 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c2: i2c@3a5018000 {
			compatible = "apple,t8142-i2c", "apple,t8103-i2c";
			reg = <0x3 0xa5018000 0x0 0x4000>;
			power-domains = <&ps_i2c2>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1249 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c3: i2c@3a501c000 {
			compatible = "apple,t8142-i2c", "apple,t8103-i2c";
			reg = <0x3 0xa501c000 0x0 0x4000>;
			power-domains = <&ps_i2c3>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1250 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		i2c4: i2c@3a5020000 {
			compatible = "apple,t8142-i2c", "apple,t8103-i2c";
			reg = <0x3 0xa5020000 0x0 0x4000>;
			power-domains = <&ps_i2c4>;
			clocks = <&clkref>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1251 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "disabled";
		};

		serial0: serial@3a5200000 {
			compatible = "apple,s5l-uart";
			reg = <0x3 0xa5200000 0x0 0x1000>;
			power-domains = <&ps_uart0>;
			reg-io-width = <4>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1231 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clkref>, <&clkref>;
			clock-names = "uart", "clk_uart_baud0";
			status = "disabled";
		};

		/*
		 * USB2 gadget-only bring-up: plain DWC3 core on the PHY state m1n1 leaves
		 * behind (USB2 PHY running, pipehandler in dummy mux). No ATC PHY / tipd
		 * driver yet, so no host mode, no SuperSpeed and no role switching.
		 */

		dwc3_0_dart_0: iommu@402f00000 {
			compatible = "apple,t8142-dart", "apple,t8110-dart";
			reg = <0x4 0x02f00000 0x0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1515 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc0_usb>;
			#iommu-cells = <1>;
		};

		dwc3_0_dart_1: iommu@402f80000 {
			compatible = "apple,t8142-dart", "apple,t8110-dart";
			reg = <0x4 0x02f80000 0x0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1515 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc0_usb>;
			#iommu-cells = <1>;
		};

		dwc3_0: usb@402280000 {
			compatible = "snps,dwc3";
			reg = <0x4 0x02280000 0x0 0xcd00>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1511 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "peripheral";
			maximum-speed = "high-speed";
			snps,dis_u2_susphy_quirk;
			snps,dis_u3_susphy_quirk;
			iommus = <&dwc3_0_dart_0 0>, <&dwc3_0_dart_1 1>;
			power-domains = <&ps_atc0_usb>;
		};

		dwc3_1_dart_0: iommu@40af00000 {
			compatible = "apple,t8142-dart", "apple,t8110-dart";
			reg = <0x4 0x0af00000 0x0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1578 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc1_usb>;
			#iommu-cells = <1>;
		};

		dwc3_1_dart_1: iommu@40af80000 {
			compatible = "apple,t8142-dart", "apple,t8110-dart";
			reg = <0x4 0x0af80000 0x0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1578 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc1_usb>;
			#iommu-cells = <1>;
		};

		dwc3_1: usb@40a280000 {
			compatible = "snps,dwc3";
			reg = <0x4 0x0a280000 0x0 0xcd00>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1574 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "peripheral";
			maximum-speed = "high-speed";
			snps,dis_u2_susphy_quirk;
			snps,dis_u3_susphy_quirk;
			iommus = <&dwc3_1_dart_0 0>, <&dwc3_1_dart_1 1>;
			power-domains = <&ps_atc1_usb>;
		};

		dwc3_3_dart_0: iommu@41af00000 {
			compatible = "apple,t8142-dart", "apple,t8110-dart";
			reg = <0x4 0x1af00000 0x0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1704 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc3_usb>;
			#iommu-cells = <1>;
		};

		dwc3_3_dart_1: iommu@41af80000 {
			compatible = "apple,t8142-dart", "apple,t8110-dart";
			reg = <0x4 0x1af80000 0x0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1704 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&ps_atc3_usb>;
			#iommu-cells = <1>;
		};

		dwc3_3: usb@41a280000 {
			compatible = "snps,dwc3";
			reg = <0x4 0x1a280000 0x0 0xcd00>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1700 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "peripheral";
			maximum-speed = "high-speed";
			snps,dis_u2_susphy_quirk;
			snps,dis_u3_susphy_quirk;
			iommus = <&dwc3_3_dart_0 0>, <&dwc3_3_dart_1 1>;
			power-domains = <&ps_atc3_usb>;
		};
	};
};

#include "t8142-pmgr.dtsi"
