/*
 * Apple MacBook Pro (14-inch, M5)
 *
 * target-type: J704 (Mac17,2)
 *
 * Minimal bring-up tree: CPUs, AIC, timer, watchdog and the boot
 * framebuffer (filled in by m1n1). Everything else is TODO.
 */

/dts-v1/;

#include "t8142.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "apple,j704", "apple,t8142", "apple,arm-platform";
	model = "Apple MacBook Pro (14-inch, M5)";

	aliases {
		serial0 = &serial0;
		keyboard = &keyboard;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bootargs = "earlycon console=tty0 loglevel=8";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by loader */
			/* Format properties will be added by loader */
			status = "disabled";
		};
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0 0x2 0>; /* To be filled by loader */
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* To be filled by loader */
	};

	/* ADT fpwm0/kbd-backlight: default-hz 25000 */
	led-controller {
		compatible = "pwm-leds";
		led-0 {
			pwms = <&fpwm0 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

/* Internal SSD (#191). Read-only use until the owner decides otherwise. */
&ans_mbox {
	status = "okay";
};

&sart {
	status = "okay";
};

&nvme {
	status = "okay";
};

/*
 * Keyboard and trackpad (MTP over DockChannel, #200). The trackpad needs
 * its multi-touch firmware (asahi-installer's converter output for the
 * j704 Multitouch.im4p); the keyboard does not.
 */
&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	status = "okay";

	multi-touch {
		firmware-name = "apple/tpmtfw-j704.bin";
		/* ADT function-afe-reset: SMC key gP1c, active low */
		reset-gpios = <&smc_gpio 28 GPIO_ACTIVE_LOW>;
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};

	stm {
	};

	actuator {
	};

	tp-accel {
	};

	mtp {
	};
};

&fpwm0 {
	status = "okay";
};

/*
 * Left-side USB-C ports' SN201202x USB-PD controllers (ADT hpm0 left-front
 * USID 0xc, hpm1 left-rear USID 0xa). No interrupts: the generation 4 SPMI
 * controller is polled, and so is the PD controller. Not linked to the DWC3s
 * or PHYs yet (status reporting only).
 */
&nub_spmi_a0 {
	status = "okay";

	hpm0: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-front";
			power-role = "dual";
			data-role = "dual";
		};
	};

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-back";
			power-role = "dual";
			data-role = "dual";
		};
	};
};

#include "hwmon-common.dtsi"
#include "hwmon-laptop.dtsi"
